rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS COLLECTION ──────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && (
        // ✅ Field-based checks FIRST (for queryable fields)
        resource.data.role == "nutritionist" ||
        resource.data.nutritionistId == request.auth.uid ||
        // ✅ UID-based check (document identity)
        request.auth.uid == userId ||
        // ✅ Admin check
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );

      // CREATE: Own profile or Admin
      allow create: if request.auth != null && (
        request.auth.uid == userId || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );

      // UPDATE: Own profile (role locked), Admin, or Nutritionist assigning themselves
      allow update: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin") ||
        (
          ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "nutritionist") || exists(/databases/$(database)/documents/nutritionists/$(request.auth.uid))) && 
          request.resource.data.nutritionistId == request.auth.uid
        )
      );

      // DELETE: Admin only
      allow delete: if request.auth != null && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    // ── MEALS (Daily logs) ────────────────────────────────
    match /meals/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "nutritionist"]) ||
        exists(/databases/$(database)/documents/nutritionists/$(request.auth.uid)) ||
        (request.resource.data.userId == request.auth.uid)
      );
    }

    // ── NUTRITIONIST REQUESTS ─────────────────────────────
    match /nutritionist_requests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.nutritionistId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.nutritionistId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // ── FOOD DETECTIONS ───────────────────────────────────
    match /food_detections/{docId} {
      allow read, update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }

    // ── FOOD LOGS ─────────────────────────────────────────
    match /food_logs/{docId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin") ||
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "nutritionist") &&
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.nutritionistId == request.auth.uid
        ) ||
        exists(/databases/$(database)/documents/nutritionists/$(request.auth.uid))
      );

      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );

      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin") ||
        (
          ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "nutritionist") || exists(/databases/$(database)/documents/nutritionists/$(request.auth.uid))) && 
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.nutritionistId == request.auth.uid
        )
      );
    }

    // ── CHATS & MESSAGES ──────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        resource == null || // Initial create
        resource.data.userId == request.auth.uid || 
        resource.data.nutritionistId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );

      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.nutritionistId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
        );
      }
    }

    // ── DIET RECOMMENDATIONS ──────────────────────────────
    match /diet_recommendations/{userId} {
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin") ||
        (
          ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "nutritionist") || exists(/databases/$(database)/documents/nutritionists/$(request.auth.uid))) && 
          get(/databases/$(database)/documents/users/$(userId)).data.nutritionistId == request.auth.uid
        )
      );
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "nutritionist") ||
        exists(/databases/$(database)/documents/nutritionists/$(request.auth.uid))
      );
    }

    // ── NOTIFICATIONS ─────────────────────────────────────
    match /notifications/{docId} {
      allow read, update, delete: if request.auth != null && (
        resource.data.receiverId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
      allow create: if request.auth != null;
    }

    // ── LEGACY NUTRITIONISTS (Browsing) ───────────────────
    match /nutritionists/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }
  }
}
